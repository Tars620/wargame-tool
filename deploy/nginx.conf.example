# Exemple nginx : remplacer wargame.example.com et les chemins du certificat (certbot, ou un certificat d'origine Cloudflare).
# Le serveur Python écoute seulement en interne (127.0.0.1:8090) ; nginx est la seule porte vers Internet.
limit_req_zone $binary_remote_addr zone=wargame_tuiles:10m rate=40r/s;

server {
    listen 80;
    server_name wargame.example.com;
    location /.well-known/acme-challenge/ { root /var/www/wargame-acme; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name wargame.example.com;

    ssl_certificate /etc/letsencrypt/live/wargame.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/wargame.example.com/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Robots-Tag "noindex, nofollow" always;
    client_max_body_size 8m;

    # Les en-têtes X-Forwarded-* sont indispensables : le serveur s'en sert pour distinguer un visiteur distant de l'ordinateur local
    # (la création de parties et le lien Internet temporaire ne sont pilotés que depuis la machine elle-même, ou avec la clé de création).
    location /enligne/ {
        limit_req zone=wargame_tuiles burst=120 nodelay;
        proxy_pass http://127.0.0.1:8090;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location / {
        proxy_pass http://127.0.0.1:8090;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120;
    }
}
